{
  // A second copy of the relay, used only for Claude (Anthropic).
  // Deploy with: npx wrangler deploy -c wrangler.claude.jsonc   (run inside the relay folder)
  //
  // Why a second copy: the main relay runs in the Cloudflare location nearest to our server,
  // and Anthropic refuses requests that arrive from there. This copy is told to run in the
  // United States, where Anthropic's own servers are. Voice calls keep using the main relay,
  // so they do not get slower.
  //
  // On the app's server set ANTHROPIC_BASE_URL to this worker's address followed by /anthropic.
  "name": "talkreal-claude",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "placement": { "region": "aws:us-east-1" },
  "vars": {
    // The public IP address of the Talkreal server at Timeweb. Only this address may use the relay.
    "ALLOWED_IPS": "5.42.111.75"
  }
}
